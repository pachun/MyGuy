{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "checks": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "marked-terminal": "^7.3.0",
    "wrap-ansi": "^10.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "^1.3.14",
    "@types/marked-terminal": "^6.1.1",
    "nock": "^15.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
